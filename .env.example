# PlanIQ — variables de entorno
# Copiar a .env y completar. Nunca versionar .env ni poner credenciales reales en este archivo.
# Los comentarios van en su propia línea: no todos los lectores de .env aceptan comentarios al final del valor.

# --- General -----------------------------------------------------------------
# development | qa | production
APP_ENV=development
# Zona horaria por defecto de las plantas nuevas
APP_TIMEZONE=America/Santiago
# URL pública detrás del proxy
PUBLIC_BASE_URL=http://localhost:8080

# --- Docker Compose ----------------------------------------------------------
# Puerto del proxy en el equipo (80 y 8000 suelen estar ocupados por otros servicios)
HTTP_PORT=8080
# Interfaz donde se publica el proxy. En desarrollo con Docker Desktop + WSL usar 127.0.0.1:
# con 0.0.0.0, WSL crea un reenvío en [::1] que deja colgado http://localhost:8080.
# Para probar desde un celular en la misma red, usar 0.0.0.0 y entrar por la IP del equipo.
HTTP_BIND=127.0.0.1
# Memoria máxima del worker
WORKER_MEMORY_LIMIT=2g

# --- SQL Server (contenedor de desarrollo) -----------------------------------
# Solo para crear la base y el usuario de aplicación en desarrollo.
# Debe cumplir la política de SQL Server: 8+ caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=CambiarEsta_Clave1
# Express en desarrollo y QA
MSSQL_PID=Express
# Puerto en localhost para SSMS / Azure Data Studio (localhost,14330); 1433 suele estar ocupado
DB_HOST_PORT=14330

# --- Base de datos propia (planiq) -------------------------------------------
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=planiq
DB_USER=planiq_app
DB_PASSWORD=CambiarEsta_Clave2
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Solo desarrollo: aceptar el certificado autofirmado del contenedor
DB_TRUST_SERVER_CERTIFICATE=yes

# --- Réplicas de Innova (solo lectura; vacío hasta la Fase 2) ----------------
INNOVA_DB_HOST=
INNOVA_DB_PORT=1433
INNOVA_DB_NAME=
INNOVA_DB_USER=
INNOVA_DB_PASSWORD=
INNOVA_SYNC_INTERVAL_SECONDS=300

# --- Autenticación -----------------------------------------------------------
JWT_SECRET=generar-un-valor-aleatorio-largo
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
# 0 = desbloqueo solo manual por Admin
AUTH_AUTO_UNLOCK_MINUTES=0
AUTH_PASSWORD_MIN_LENGTH=10
AUTH_LOGIN_RATE_LIMIT=10/minute

# --- Administrador inicial (se exige cambio de contraseña al primer ingreso) -
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=CambiarEsta_Clave3

# --- Cargas de archivos ------------------------------------------------------
UPLOAD_MAX_SIZE_MB=300
FILE_STORAGE_PATH=/data/storage
