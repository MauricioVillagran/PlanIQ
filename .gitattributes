# Finales de línea LF en el repositorio y en la copia de trabajo:
# los scripts y Dockerfiles se ejecutan dentro de contenedores Linux.
* text=auto eol=lf

# Scripts propios de Windows
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

